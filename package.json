{
  "name": "upsc-static-study-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync-data && vite",
    "sync-data": "mkdir -p public/data && cp data/*.json public/data/",
    "build": "npm run sync-data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "python3 -I scripts/validate.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}